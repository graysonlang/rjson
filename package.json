{
  "name": "@graysonlang/rjson",
  "version": "1.2.0",
  "description": "Relaxed JSON parser for standard JSON plus comments and trailing commas.",
  "keywords": [
    "json",
    "relaxed-json",
    "comments",
    "trailing-commas",
    "config",
    "parser"
  ],
  "homepage": "https://github.com/graysonlang/rjson#readme",
  "bugs": {
    "url": "https://github.com/graysonlang/rjson/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/graysonlang/rjson.git"
  },
  "license": "MIT",
  "author": "Grayson Lang",
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/rjson.d.ts",
      "default": "./src/rjson.js"
    }
  },
  "main": "./src/rjson.js",
  "types": "./src/rjson.d.ts",
  "files": [
    "src/rjson.js",
    "src/rjson.d.ts"
  ],
  "scripts": {
    "prepare": "node ./scripts/prepare.mjs",
    "ports": "node ./scripts/build.mjs --print-port",
    "sync:launch": "node ./scripts/build.mjs --sync-launch",
    "build": "node ./scripts/build.mjs --lint --minify",
    "test": "node ./scripts/test.mjs",
    "deploy-test": "node ./scripts/pack-test.mjs",
    "serve": "node ./scripts/build.mjs --lint --sourcemap --watch --serve --debug-port=auto",
    "dev": "npm run serve -- --proxy --launch",
    "vscode:build": "npm run build -- --vscode",
    "vscode:debug": "npm run serve -- --vscode",
    "lint": "biome check .",
    "lint:fix": "biome check --write ."
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.0",
    "@graysonlang/esp": "^2.1.0",
    "esbuild": "^0.28.0",
    "typescript": "^5.8.0"
  },
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public"
  },
  "sideEffects": false
}
